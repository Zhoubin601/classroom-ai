# Classroom AI Backend & Docker Environment Configurations
MYSQL_PORT=3308
REDIS_PORT=6379
BACKEND_PORT=8080

MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=classroom_ai

# Spring datasource when running locally outside docker
SPRING_DATASOURCE_HOST=localhost
SPRING_DATASOURCE_PORT=3308
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=root

# Redis when running locally outside docker
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
