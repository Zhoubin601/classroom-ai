+    <T> List<T> race(Supplier<T> action) throws Exception {
+        try (var pool = Executors.newFixedThreadPool(2)) {
+            CountDownLatch ready = new CountDownLatch(2), start = new CountDownLatch(1);
+            Callable<T> worker = () -> {
